<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{9C2E7B1A-3F4D-4E6B-8A2C-1D5F6E7A8B9C}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>CombatAI</RootNamespace>
    <AssemblyName>CombatAI</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>9.0</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- Bannerlord install root. Default keeps the current machine working;
         override via `dotnet build -p:BannerlordDir="D:\...\Mount & Blade II Bannerlord"`
         or a BannerlordDir environment variable when the game lives on another drive. -->
    <BannerlordDir Condition="'$(BannerlordDir)' == ''">C:\Program Files %28x86%29\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(BannerlordDir)\Modules\BCCrBridge\bin\Win64_Shipping_Client\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>5</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
    <!-- unsafe required by NativeTargetGuard.cs (native memory reads/writes
         for the target-release crash guard; the NativeHook module proves
         unsafe code works in-process). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>$(BannerlordDir)\Modules\BCCrBridge\bin\Win64_Shipping_Client\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(BannerlordDir)\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(BannerlordDir)\bin\Win64_Shipping_Client\TaleWorlds.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.DotNet">
      <HintPath>$(BannerlordDir)\bin\Win64_Shipping_Client\TaleWorlds.DotNet.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(BannerlordDir)\bin\Win64_Shipping_Client\TaleWorlds.Engine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.InputSystem">
      <HintPath>$(BannerlordDir)\bin\Win64_Shipping_Client\TaleWorlds.InputSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(BannerlordDir)\bin\Win64_Shipping_Client\TaleWorlds.Library.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.ModuleManager">
      <HintPath>$(BannerlordDir)\bin\Win64_Shipping_Client\TaleWorlds.ModuleManager.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(BannerlordDir)\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(BannerlordDir)\bin\Win64_Shipping_Client\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Bannerlord.Harmony module, already a hard dependency of MasterStrikes
         itself, so anyone running it already has this installed. Used for a
         single direct patch (see MasterStrikesHarmonyPatches.cs) rather than
         the Agent/AgentComponent override pattern used everywhere else in
         this mod. -->
    <Reference Include="0Harmony">
      <HintPath>$(BannerlordDir)\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- MCM (Mod Configuration Menu). BCCrBridge/SubModule.xml already makes Bannerlord.MBOptionScreen a
         hard dependency, so it is loaded first. Every MCM touch is inside CombatAiSettings.cs and guarded in
         CombatAiMcmBridge so a missing MCM just means the shipped defaults. -->
    <Reference Include="MCMv5">
      <HintPath>$(BannerlordDir)\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Vanilla Sandbox module: ArenaPracticeFightMissionController lives here
         (participant detection for the arena fight modes). Native dep. -->
    <Reference Include="SandBox">
      <HintPath>$(BannerlordDir)\Modules\Sandbox\bin\Win64_Shipping_Client\SandBox.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- ArenaOverhaulRedux: hard dependency declared in BCCrBridge/SubModule.xml. -->
    <Reference Include="ArenaOverhaulRedux.v1.5.7">
      <HintPath>$(BannerlordDir)\Modules\PreparedModPack6\ArenaOverhaulRedux\bin\Win64_Shipping_Client\ArenaOverhaulRedux.v1.5.7.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- EasyHook (managed front-end of the NativeHook module's hook engine).
         Private=True: copied next to CombatAI.dll so the module is
         self-contained even though BCCrBridge/SubModule.xml also declares a
         hard DependedModule on NativeHook (per user request). The unmanaged
         support binaries EasyHook64/32.dll + EasyLoad64/32.dll must sit next
         to CombatAI.dll at runtime too — copied by the None items below. -->
    <Reference Include="EasyHook">
      <HintPath>$(BannerlordDir)\Modules\NativeHook\bin\Win64_Shipping_Client\EasyHook.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(BannerlordDir)\Modules\NativeHook\bin\Win64_Shipping_Client\EasyHook64.dll">
      <Link>EasyHook64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(BannerlordDir)\Modules\NativeHook\bin\Win64_Shipping_Client\EasyHook32.dll">
      <Link>EasyHook32.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(BannerlordDir)\Modules\NativeHook\bin\Win64_Shipping_Client\EasyLoad64.dll">
      <Link>EasyLoad64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(BannerlordDir)\Modules\NativeHook\bin\Win64_Shipping_Client\EasyLoad32.dll">
      <Link>EasyLoad32.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
